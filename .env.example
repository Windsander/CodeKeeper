# ============================================================
# CodeKeeper 环境变量配置 — 所有配置都在此文件完成
# 复制为 .env 并填入实际值即可启动
# ============================================================

# Anthropic API Key（用于 AI 代码审查，必填）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# -----------------------------------------------------------
# 项目1: my-project（必填至少一个项目）
# -----------------------------------------------------------
# 项目本地路径
CODEKEEPER_PROJECT_MYPROJECT_PATH=/path/to/your/project
# GitLab 地址
CODEKEEPER_PROJECT_MYPROJECT_GITLAB_URL=https://git.example.com
# GitLab 项目路径（group/project）
CODEKEEPER_PROJECT_MYPROJECT_GITLAB_PROJECT=group/your-project
# GitLab Token（或直接写 glpat-xxxxx）
CODEKEEPER_PROJECT_MYPROJECT_TOKEN=env:GITLAB_TOKEN
# 审查间隔（cron 表达式，默认每30分钟）
CODEKEEPER_PROJECT_MYPROJECT_SCHEDULE=*/30 * * * *
# 是否自动修复（true/false，默认 false）
CODEKEEPER_PROJECT_MYPROJECT_AUTO_FIX=false

# -----------------------------------------------------------
# 项目2: 其他项目（可选，复制上面的格式修改 ID 即可）
# -----------------------------------------------------------
# CODEKEEPER_PROJECT_ANOTHER_PATH=/path/to/another
# CODEKEEPER_PROJECT_ANOTHER_GITLAB_URL=https://git.example.com
# CODEKEEPER_PROJECT_ANOTHER_GITLAB_PROJECT=group/another
# CODEKEEPER_PROJECT_ANOTHER_TOKEN=env:GITLAB_TOKEN_ANOTHER

# -----------------------------------------------------------
# 可选全局设置
# -----------------------------------------------------------
# 日志级别: debug | info | warn | error（默认 info）
# CODEKEEPER_LOG_LEVEL=info

# 时区（默认 Asia/Shanghai）
# CODEKEEPER_TIMEZONE=Asia/Shanghai

# AI 模型上下文限制（默认 200000）
# CODEKEEPER_TOKEN_BUDGET=200000
